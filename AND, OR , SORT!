t = int(input())
for i in range(t):
    n = int(input())
    s = input()
    c = n-1
    one = 0
    zero = s.count("0")
    for j in range(n):
        if s[j] == "1":
            one += 1
        elif s[j] == "0":
            zero -= 1
        c = min(c,zero + one)        
    if list(s) == sorted(s):
        print(0)
    elif s[0] == "1":
        print(s.count("0"))    
    else:
        print(c) 
