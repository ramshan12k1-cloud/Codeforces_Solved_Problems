from math import lcm
t = int(input())
for _ in range(t):
    a, b, c, m = map(int, input().split())
    x = m // lcm(a, b)
    y = m // lcm(a, c)
    z = m // lcm(b, c)
    w = m // lcm(a, b, c)
    p = 6 * (m // a) - 3 * x - 3 * y + 2 * w
    q = 6 * (m // b) - 3 * x - 3 * z + 2 * w
    r = 6 * (m // c) - 3 * y - 3 * z + 2 * w
    print(p, q, r)
