t = int(input())
for _ in range(t):
    b1,b2,b3,b4,b5 = [],[],[],[],[]
    for i in range(10):
        a = input()
        if i == 0 or i == 9:
            b1.extend(a)
        else:
            if i == 1 or i == 8:
                b2.extend(a[1:9])
                b1.extend([ a[0],a[9] ]) 
            elif i == 2 or i == 7:
                b3.extend(a[2:8])
                b2.extend([ a[1],a[8] ])
                b1.extend([ a[0],a[9] ])
            elif i == 3 or i == 6:
                b4.extend(a[3:7])
                b3.extend([ a[2],a[7] ])
                b2.extend([ a[1],a[8] ])
                b1.extend([ a[0],a[9] ])
            elif i == 4 or i == 5:
                b5.extend(a[4:6])
                b4.extend([ a[3],a[6] ])
                b3.extend([ a[2],a[7] ])
                b2.extend([ a[1],a[8] ])
                b1.extend([ a[0],a[9] ]) 
    print(b1.count("X") + b2.count("X")*2 + b3.count("X")*3 + b4.count("X")*4 + b5.count("X")*5)           
                
