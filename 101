t = int(input())
for _ in range(t):
    n = int(input())
    a = list(map(int,input().split()))
    k = False 
    for i in range(n):
        if a[i] == 1 or a[i] == -1:
            a[i] =  1
            break 
    for j in range(n-1,0,-1):
        if k:
            if a[j] == -1:
                a[j] = 0
        elif a[j] == 1 or a[j] == -1:
            a[j] = 1
            k = True
    print(*a)           
