import math
t  = int(input())
for i in range(t):
    n = int(input())
    a = list(map(int,input().split()))
    c = 0
    for i in range (1,n):
        if abs(a[i-1] - a[i]) == 1 or abs(a[i-1] - a[i]) == math.gcd(a[i-1],a[i]):
            c += 1
    if max(a)-min(a) == math.gcd(*a) and n > 2:
        c += 1
    print(c)            
